# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codearena

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# Judge0 Code Execution
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key
JUDGE0_MAX_CONCURRENT=10
CODE_TIMEOUT_SECONDS=10
CODE_MEMORY_LIMIT_KB=262144

# App Config
MAX_VIOLATIONS_DEFAULT=3
CORS_ORIGINS=http://localhost:5173
AUTO_SAVE_INTERVAL_SECONDS=15
SUBMISSION_GRACE_PERIOD_SECONDS=5
