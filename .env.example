# ==============================================================================
# CodeArena Environment Variables (backend)
# ==============================================================================

# Database (PostgreSQL / Supabase) — use the pooler connection string from
# Project Settings > Database > Connection string ("Transaction" mode).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# In-container judge (Docker) execution
# The backend runs inside a Docker container that ships Python 3.11, OpenJDK 17,
# GCC and G++. Student code is compiled/run with resource limits in temp dirs.
ALLOW_LOCAL_EXECUTION=True
MAX_CONCURRENT_EXECUTIONS=20
CODE_TIMEOUT_SECONDS=5
TIMEOUT_PYTHON=3.0
TIMEOUT_C=2.0
TIMEOUT_CPP=2.0
TIMEOUT_JAVA=3.0
CODE_MEMORY_LIMIT_KB=262144   # 256 MB (capped via RLIMIT_AS; Java uses -Xmx)

# App Config
MAX_VIOLATIONS_DEFAULT=3
CORS_ORIGINS=http://localhost:5173,https://codearena-frontend.onrender.com,https://codearena-indol.vercel.app
AUTO_SAVE_INTERVAL_SECONDS=15
SUBMISSION_GRACE_PERIOD_SECONDS=5

# Supabase (mirroring attempts/submissions through the frontend's Supabase flows)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (optional AI co-pilot features)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# Frontend (Vite) variables — set on the static-site hosting platform
# ==============================================================================
# VITE_API_URL=https://codearena-api.onrender.com
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=